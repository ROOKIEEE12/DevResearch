# ==========================================
# DevResearch Environment Configuration
# ==========================================

# 1. LLM Provider (Anthropic Claude) — REQUIRED for synthesis & follow-up
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Web Search Connector (Tavily or Brave) — at least one recommended
TAVILY_API_KEY=your_tavily_api_key_here
# BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# 3. Academic & Papers Connectors
# arXiv is open — no key needed!
# Semantic Scholar key is optional (higher rate limits)
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# 4. Developer & Community Connectors
# GitHub Personal Access Token (higher rate limits for Issues/Discussions)
GITHUB_TOKEN=your_github_personal_access_token_here

# YouTube Data API v3 (video search & transcripts)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit & Hacker News use public REST APIs — no mandatory key
# REDDIT_CLIENT_ID=your_reddit_client_id_here
# REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# 5. Database Configuration
DATABASE_URL="file:./devresearch.db"

