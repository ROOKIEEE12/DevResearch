# ==========================================
# DevResearch Environment Configuration
# ==========================================

# 1. LLM Provider (Anthropic Claude)
# Required for query planning, synthesis & follow-up chat
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Web Search Connector (Tavily or Brave)
# At least one web search API key is recommended
TAVILY_API_KEY=your_tavily_api_key_here
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# 3. Academic & Papers Connectors
# arXiv is open & requires no API key!
# Semantic Scholar API key is optional (higher rate limits)
# SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# 4. Developer & Community Connectors
# GitHub Personal Access Token (optional, for higher rate limits on Issues/Discussions)
GITHUB_TOKEN=your_github_personal_access_token_here

# YouTube Data API v3 key (for video search & transcripts)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit & Hacker News use public JSON REST endpoints (no mandatory key)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# 5. Database Configuration
# Defaults to SQLite file in workspace
DATABASE_URL="file:./devresearch.db"

